{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deulkyeotda",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "routes": [{ "pattern": "deulkyutda.sourity.com", "custom_domain": true }],
  "build": { "command": "node scripts/build-assets.mjs" },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deulkyeotda",
      "database_id": "c223c313-7b43-4be4-aa70-700f789e16e6",
      "migrations_dir": "drizzle"
    }
  ],
  "ratelimits": [
    { "name": "PREDICT_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": { "OPENAI_MODEL": "gpt-6-luna", "OPENAI_REASONING_EFFORT": "low", "AI_DAILY_LIMIT": "1000" },
  "observability": { "enabled": true }
}
